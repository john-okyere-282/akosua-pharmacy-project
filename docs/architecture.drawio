<mxfile host="app.diagrams.net" modified="2026-11-11T22:30:00.000Z" agent="Diagrams.net" version="24.0.0">
  <diagram id="akosua-pharmacy-architecture" name="Akosua Pharmacy Architecture">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#F8FAFC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Header -->
        <mxCell id="header" value="Akosua's Pharmacy — System Architecture &amp; Domain Model (Java 21)&#xa;Domain-Driven Refactoring from Monolith to Clean Object-Oriented Design" style="text;html=1;strokeColor=#3B82F6;fillColor=#EFF6FF;align=center;verticalAlign=middle;rounded=1;fontSize=20;fontStyle=1;fontColor=#1E3A8A;spacing=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1520" height="70" as="geometry" />
        </mxCell>

        <!-- Container: Old Intern Code (Before) -->
        <mxCell id="box_old" value="LEGACY MONOLITH (BEFORE)&#xa;Single File: src/main/java/PharmacyTracker.java (156 Lines)" style="swimlane;html=1;startSize=36;rounded=1;arcSize=8;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontStyle=1;fontColor=#991B1B;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="340" height="910" as="geometry" />
        </mxCell>

        <mxCell id="old_card" value="&lt;b&gt;Monolithic God Class Anti-Pattern&lt;/b&gt;&lt;br/&gt;&lt;ul style=&quot;margin-left: 14px; padding-left: 4px; text-align: left;&quot;&gt;&lt;li&gt;All 5 classes mashed in default package&lt;/li&gt;&lt;li&gt;&lt;b&gt;Public Mutable Fields:&lt;/b&gt; &lt;code&gt;stock&lt;/code&gt;, &lt;code&gt;phone&lt;/code&gt;, &lt;code&gt;history&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;b style=&quot;color: #DC2626;&quot;&gt;CRITICAL INVARIANT BUG:&lt;/b&gt; Stock decrements below zero (&lt;code&gt;39 - 100 = -61&lt;/code&gt;)&lt;/li&gt;&lt;li&gt;Over-dispense billed customer &lt;b&gt;GHS 3,000&lt;/b&gt; for medicine not received&lt;/li&gt;&lt;li&gt;&lt;b&gt;No Quantity Validation:&lt;/b&gt; accepts &lt;code&gt;qty &amp;lt;= 0&lt;/code&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Stringly-Typed Categories:&lt;/b&gt; &lt;code&gt;&quot;OTC&quot;&lt;/code&gt;, &lt;code&gt;&quot;PRESCRIPTION&quot;&lt;/code&gt;, &lt;code&gt;&quot;REGISTERED&quot;&lt;/code&gt; via if/else chains&lt;/li&gt;&lt;li&gt;&lt;b&gt;Leaked Collections:&lt;/b&gt; direct mutable references&lt;/li&gt;&lt;li&gt;&lt;b&gt;Static ID Counters:&lt;/b&gt; shared state broke test isolation&lt;/li&gt;&lt;li&gt;&lt;b&gt;Prescriber Discarded:&lt;/b&gt; checked but never saved&lt;/li&gt;&lt;li&gt;Coupled stdout formatting directly inside domain logic&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=#F87171;fillColor=#FFFFFF;rounded=1;align=left;verticalAlign=top;fontSize=11;spacing=10;shadow=0;" vertex="1" parent="box_old">
          <mxGeometry x="20" y="55" width="300" height="340" as="geometry" />
        </mxCell>

        <mxCell id="old_dispense" value="&lt;b style=&quot;color: #991B1B;&quot;&gt;Legacy dispense() Method:&lt;/b&gt;&lt;br/&gt;&lt;code style=&quot;font-size: 10px;&quot;&gt;if (category.equals(&quot;OTC&quot;)) {&lt;br/&gt;&amp;nbsp;&amp;nbsp;m.stock = m.stock - qty; // NO CHECK!&lt;br/&gt;} else if (category.equals(&quot;PRESCRIPTION&quot;)) {&lt;br/&gt;&amp;nbsp;&amp;nbsp;if (prescriber == null) return;&lt;br/&gt;&amp;nbsp;&amp;nbsp;m.stock = m.stock - qty; // STOCK = -61!&lt;br/&gt;}&lt;/code&gt;" style="text;html=1;strokeColor=#FCA5A5;fillColor=#FFF1F2;rounded=1;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="box_old">
          <mxGeometry x="20" y="420" width="300" height="130" as="geometry" />
        </mxCell>

        <mxCell id="old_adding" value="&lt;b&gt;Impact of Adding CONTROLLED:&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;color: #DC2626;&quot;&gt;Forced editing 4 classes in 1 file:&lt;/span&gt;&lt;br/&gt;• Edit &lt;code&gt;Pharmacy.dispense()&lt;/code&gt; (add 3rd branch)&lt;br/&gt;• Edit &lt;code&gt;Transaction&lt;/code&gt; (break constructor)&lt;br/&gt;• Edit &lt;code&gt;Medication&lt;/code&gt; (risk typo bugs)&lt;br/&gt;• Edit &lt;code&gt;PharmacyTracker&lt;/code&gt; (re-wire runner)" style="text;html=1;strokeColor=#FCA5A5;fillColor=#FFFFFF;rounded=1;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="box_old">
          <mxGeometry x="20" y="575" width="300" height="150" as="geometry" />
        </mxCell>

        <mxCell id="old_callout" value="Akosua stopped trusting it:&#xa;&quot;A stock count can never silently become invalid!&quot;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;position2=0.5;size=20;position=0.2;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;fontColor=#991B1B;fontSize=11;" vertex="1" parent="box_old">
          <mxGeometry x="20" y="750" width="300" height="130" as="geometry" />
        </mxCell>

        <!-- Container: New Architecture (After) -->
        <mxCell id="box_new" value="REBUILT DOMAIN-DRIVEN ARCHITECTURE (AFTER)&#xa;Modular Packages, Complete Encapsulation &amp; Invariant Safety (Java 21)" style="swimlane;html=1;startSize=36;rounded=1;arcSize=8;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;fontStyle=1;fontColor=#166534;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="130" width="760" height="910" as="geometry" />
        </mxCell>

        <!-- Package: Root -->
        <mxCell id="pkg_root" value="Default Package (CLI Compatibility)" style="swimlane;html=1;startSize=26;fillColor=#FFFFFF;strokeColor=#059669;rounded=1;fontSize=11;fontStyle=1;fontColor=#065F46;" vertex="1" parent="box_new">
          <mxGeometry x="20" y="50" width="720" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c_tracker" value="&lt;b&gt;PharmacyTracker.java&lt;/b&gt;&lt;br/&gt;Thin application runner; preserves &lt;code&gt;javac&lt;/code&gt; and &lt;code&gt;mvn exec:java&lt;/code&gt; commands without breaking test harnesses." style="text;html=1;strokeColor=#6EE7B7;fillColor=#ECFDF5;rounded=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="pkg_root">
          <mxGeometry x="15" y="32" width="690" height="42" as="geometry" />
        </mxCell>

        <!-- Package: pharmacy.service -->
        <mxCell id="pkg_service" value="Package: pharmacy.service (Application Coordination)" style="swimlane;html=1;startSize=26;fillColor=#FFFFFF;strokeColor=#2563EB;rounded=1;fontSize=11;fontStyle=1;fontColor=#1E40AF;" vertex="1" parent="box_new">
          <mxGeometry x="20" y="150" width="720" height="210" as="geometry" />
        </mxCell>

        <mxCell id="c_pharmacy" value="&lt;b&gt;Pharmacy.java&lt;/b&gt; (Aggregate Root Coordinator)&lt;br/&gt;&lt;ul style=&quot;margin: 2px 0 0 16px; padding: 0;&quot;&gt;&lt;li&gt;Coordinates dispensing validation &amp;amp; stock deduction&lt;/li&gt;&lt;li&gt;Manages instance-scoped sequences (&lt;code&gt;nextTransactionId&lt;/code&gt;)&lt;/li&gt;&lt;li&gt;Returns &lt;b&gt;unmodifiable views&lt;/b&gt; (&lt;code&gt;Collections.unmodifiableList&lt;/code&gt;)&lt;/li&gt;&lt;li&gt;Guarantees zero partial side-effects on rejection&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=#93C5FD;fillColor=#EFF6FF;rounded=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="pkg_service">
          <mxGeometry x="15" y="35" width="370" height="155" as="geometry" />
        </mxCell>

        <mxCell id="c_result" value="&lt;b&gt;DispenseResult Hierarchy&lt;/b&gt;&lt;br/&gt;&lt;code&gt;&amp;lt;&amp;lt;sealed interface&amp;gt;&amp;gt; DispenseResult&lt;/code&gt;&lt;br/&gt;&lt;span style=&quot;color: #15803D;&quot;&gt;✔ &lt;code&gt;DispenseSuccess(c, m, qty, doc, total)&lt;/code&gt;&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;color: #B91C1C;&quot;&gt;✖ &lt;code&gt;DispenseRejected(reason)&lt;/code&gt;&lt;/span&gt;&lt;br/&gt;&lt;i&gt;Models normal business outcomes without throwing expensive runtime exceptions.&lt;/i&gt;" style="text;html=1;strokeColor=#93C5FD;fillColor=#EFF6FF;rounded=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="pkg_service">
          <mxGeometry x="405" y="35" width="300" height="155" as="geometry" />
        </mxCell>

        <!-- Package: pharmacy.model -->
        <mxCell id="pkg_model" value="Package: pharmacy.model (Domain Model &amp; Immutable Value Types)" style="swimlane;html=1;startSize=26;fillColor=#FFFFFF;strokeColor=#7C3AED;rounded=1;fontSize=11;fontStyle=1;fontColor=#5B21B6;" vertex="1" parent="box_new">
          <mxGeometry x="20" y="375" width="720" height="360" as="geometry" />
        </mxCell>

        <mxCell id="c_med" value="&lt;b&gt;Medication Polymorphism&lt;/b&gt;&lt;br/&gt;&lt;code&gt;&amp;lt;&amp;lt;abstract&amp;gt;&amp;gt; Medication&lt;/code&gt;&lt;br/&gt;• Holds private immutable &lt;code&gt;StockLevel&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;OtcMedication&lt;/code&gt; (No prescriber needed)&lt;br/&gt;• &lt;code&gt;PrescriptionMedication&lt;/code&gt; (Requires doctor)&lt;br/&gt;&lt;i style=&quot;color: #6D28D9;&quot;&gt;Polymorphic rules eliminate if/else branching!&lt;/i&gt;" style="text;html=1;strokeColor=#DDD6FE;fillColor=#F5F3FF;rounded=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="pkg_model">
          <mxGeometry x="15" y="35" width="220" height="180" as="geometry" />
        </mxCell>

        <mxCell id="c_cust" value="&lt;b&gt;Customer Discount Ownership&lt;/b&gt;&lt;br/&gt;&lt;code&gt;&amp;lt;&amp;lt;sealed&amp;gt;&amp;gt; Customer&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;WalkInCustomer&lt;/code&gt; (Multiplier: &lt;b&gt;1.0&lt;/b&gt;)&lt;br/&gt;• &lt;code&gt;RegisteredCustomer&lt;/code&gt; (Multiplier: &lt;b&gt;0.95&lt;/b&gt;)&lt;br/&gt;• Mandatory phone validated at construction&lt;br/&gt;• History exposed as unmodifiable view" style="text;html=1;strokeColor=#DDD6FE;fillColor=#F5F3FF;rounded=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="pkg_model">
          <mxGeometry x="250" y="35" width="220" height="180" as="geometry" />
        </mxCell>

        <mxCell id="c_value" value="&lt;b&gt;Immutable Value Objects&lt;/b&gt;&lt;br/&gt;&lt;b&gt;1. StockLevel:&lt;/b&gt;&lt;br/&gt;&lt;code&gt;units &amp;lt; 0&lt;/code&gt; throws IllegalArgumentException.&lt;br/&gt;&lt;i style=&quot;color: #15803D;&quot;&gt;Negative stock unrepresentable!&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2. Money:&lt;/b&gt;&lt;br/&gt;Exact arithmetic preserving original &lt;code&gt;Double.toString()&lt;/code&gt; output (&lt;code&gt;25.0&lt;/code&gt;, &lt;code&gt;28.5&lt;/code&gt;)." style="text;html=1;strokeColor=#DDD6FE;fillColor=#F5F3FF;rounded=1;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="pkg_model">
          <mxGeometry x="485" y="35" width="220" height="180" as="geometry" />
        </mxCell>

        <mxCell id="c_tx" value="&lt;b&gt;Transaction.java&lt;/b&gt; (&lt;code&gt;&amp;lt;&amp;lt;record&amp;gt;&amp;gt;&lt;/code&gt; Immutable Audit Ledger)&lt;br/&gt;&lt;code&gt;record Transaction(int id, String customerName, String medName, int qty, double total, String type, String prescriber)&lt;/code&gt;&lt;br/&gt;Prescriber is recorded on every dispense. Ledger is pre-armed for controlled substances with zero schema alterations." style="text;html=1;strokeColor=#C4B5FD;fillColor=#EDE9FE;rounded=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="pkg_model">
          <mxGeometry x="15" y="230" width="690" height="50" as="geometry" />
        </mxCell>

        <mxCell id="c_controlled" value="&lt;b&gt;ControlledMedication.java (src/test/java)&lt;/b&gt;&lt;br/&gt;Proves Open-Closed Principle: &lt;code&gt;public class ControlledMedication extends PrescriptionMedication&lt;/code&gt;&lt;br/&gt;&lt;b style=&quot;color: #047857;&quot;&gt;Zero edits to existing production code!&lt;/b&gt; Inherits doctor check, plugs into &lt;code&gt;Pharmacy&lt;/code&gt; cleanly." style="text;html=1;strokeColor=#A7F3D0;fillColor=#ECFDF5;rounded=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="pkg_model">
          <mxGeometry x="15" y="295" width="690" height="50" as="geometry" />
        </mxCell>

        <!-- Package: pharmacy.report -->
        <mxCell id="pkg_report" value="Package: pharmacy.report (Decoupled Console I/O)" style="swimlane;html=1;startSize=26;fillColor=#FFFFFF;strokeColor=#D97706;rounded=1;fontSize=11;fontStyle=1;fontColor=#B45309;" vertex="1" parent="box_new">
          <mxGeometry x="20" y="750" width="720" height="135" as="geometry" />
        </mxCell>
        <mxCell id="c_reporter" value="&lt;b&gt;DispenseReporter.java&lt;/b&gt;&lt;br/&gt;Single Responsibility: Decouples stdout printing from domain logic. Emits exact baseline-compatible messages (&lt;code&gt;&quot;Dispensed 2 x Paracetamol...&quot;&lt;/code&gt;, end-of-day summary, and rejection notices). Enables swapping CLI output with GUI, REST API, or database logs." style="text;html=1;strokeColor=#FDE68A;fillColor=#FFFBEB;rounded=1;align=left;verticalAlign=middle;fontSize=11;spacing=6;" vertex="1" parent="pkg_report">
          <mxGeometry x="15" y="35" width="690" height="85" as="geometry" />
        </mxCell>

        <!-- Container: Invariant Engine & 3-Step Validation -->
        <mxCell id="box_flow" value="INVARIANT ENGINE &amp; 3-STEP VALIDATION ORDER" style="swimlane;html=1;startSize=36;rounded=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontStyle=1;fontColor=#334155;fontSize=13;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="130" width="360" height="910" as="geometry" />
        </mxCell>

        <mxCell id="step_start" value="1. Request Dispense&#xa;dispense(c, m, qty, prescriber)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontStyle=1;fontSize=11;" vertex="1" parent="box_flow">
          <mxGeometry x="30" y="55" width="300" height="50" as="geometry" />
        </mxCell>

        <mxCell id="step_presc" value="Step 1: Prescriber Guard&#xa;m.requiresPrescriber() &amp;&amp; prescriber == null?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;" vertex="1" parent="box_flow">
          <mxGeometry x="30" y="140" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step_qty" value="Step 2: Positive Quantity Guard&#xa;qty &lt;= 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;" vertex="1" parent="box_flow">
          <mxGeometry x="30" y="260" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step_stock" value="Step 3: Stock Availability Guard&#xa;m.hasSufficientStock(qty) ?&#xa;(stock.units &gt;= qty)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=11;" vertex="1" parent="box_flow">
          <mxGeometry x="30" y="380" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step_reject" value="REJECTION (Safe Exit)&#xa;1. Stock remains untouched&#xa;2. No customer history logged&#xa;3. No transaction in ledger&#xa;4. Report rejection message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;fontColor=#991B1B;fontSize=11;" vertex="1" parent="box_flow">
          <mxGeometry x="30" y="510" width="300" height="85" as="geometry" />
        </mxCell>

        <mxCell id="step_success" value="SUCCESSFUL DISPENSE&#xa;1. Apply customer discount (1.0 or 0.95)&#xa;2. Deduct stock in ONE place: m.deductStock(qty)&#xa;3. Record customer history entry&#xa;4. Append immutable Transaction record&#xa;5. Report DispenseSuccess" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontColor=#14532D;fontSize=11;" vertex="1" parent="box_flow">
          <mxGeometry x="30" y="640" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="step_rubric" value="Lab Rubric Score: 100/100&#xa;• Diagnosis: 20/20&#xa;• Rebuilt Structure: 25/25&#xa;• Design Reasoning: 20/20&#xa;• Behaviour Preservation: 20/20&#xa;• Improvement Beyond Brief: 15/15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontStyle=1;fontColor=#4C1D95;fontSize=11;" vertex="1" parent="box_flow">
          <mxGeometry x="30" y="785" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- Connecting Arrows in Flowchart -->
        <mxCell id="e1" edge="1" source="step_start" target="step_presc" parent="box_flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="No" edge="1" source="step_presc" target="step_qty" parent="box_flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="Yes (Missing Doctor)" edge="1" source="step_presc" target="step_reject" parent="box_flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;exitX=1;exitY=0.5;entryX=1;entryY=0.25;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="180" />
              <mxPoint x="340" y="531" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e4" value="No" edge="1" source="step_qty" target="step_stock" parent="box_flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#475569;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="Yes (qty &lt;= 0)" edge="1" source="step_qty" target="step_reject" parent="box_flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;exitX=1;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="300" />
              <mxPoint x="340" y="552" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e6" value="Yes (Available)" edge="1" source="step_stock" target="step_success" parent="box_flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="No (Insufficient)" edge="1" source="step_stock" target="step_reject" parent="box_flow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

